@{
    ViewData["Title"] = "Master Technician";
}

<div class="pagetitle">
    <h1>Master Technician</h1>
    <nav>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="">Home</a></li>
            <li class="breadcrumb-item">Master Data</li>
            <li class="breadcrumb-item active">Technician</li>
        </ul>
    </nav>
</div>

<section class="section dashboard">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Technician Management</h5>
                    <button class="btn btn-primary mb-3" onclick="createTechnician()">
                        <i class="bi bi-plus-circle"></i> Create New Technician
                    </button>
                    <div class="table-responsive">
                        <table class="table table-striped cell-border" id="techniciansTable" style="width:100%">
                            <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Full Name</th>
                                    <th scope="col">Phone</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Avg Rating</th>
                                    <th scope="col">Completed Jobs</th>
                                    <th scope="col">Total Orders</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Populated by DataTables AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="~/Views/MasterData/Modals/TechnicianModals.cshtml" />

@section Scripts {
    <script type="text/javascript" src="~/js/datatables.min.js"></script>
    <script type="text/javascript" src="~/js/masterdata-technician.js"></script>
}
